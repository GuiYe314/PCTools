<Window x:Class="JuDianWorkbench.ApplicationNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置软件名称" Width="560" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Border Style="{StaticResource PanelCard}" Margin="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="软件名称" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="名称会显示在窗口标题和左侧顶部，最多 24 个字符。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="显示名称" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ApplicationNameTextBox" MaxLength="24" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="恢复默认" Click="RestoreDefault_Click" Margin="0,0,8,0"/><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
