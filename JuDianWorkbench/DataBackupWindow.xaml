<Window x:Class="JuDianWorkbench.DataBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据备份与恢复" Width="720" Height="510" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="数据备份与恢复" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="恢复前会额外保存一份当前数据，恢复完成后程序将重新启动" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="0"><ListBox x:Name="BackupList" ItemsSource="{Binding}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="恢复此备份" Tag="{Binding}" Click="Restore_Click" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="立即创建备份" Click="CreateBackup_Click" Margin="0,0,8,0"/><Button Content="关闭" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
