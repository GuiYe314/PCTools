<Window x:Class="JuDianWorkbench.UnityProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Unity 项目" Width="680" Height="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="选择 Unity 项目" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="当前管理目录中检测到多个项目，请选择要启动的项目。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding}" BorderThickness="0" Background="Transparent" MouseDoubleClick="ProjectList_MouseDoubleClick">
            <ListBox.ItemTemplate><DataTemplate><Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ProjectPath}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding EditorStatusText}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="打开项目" Style="{StaticResource PrimaryButton}" Click="Open_Click"/></StackPanel>
    </Grid>
</Window>
