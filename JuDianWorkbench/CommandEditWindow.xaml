<Window x:Class="JuDianWorkbench.CommandEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑快捷命令" Width="700" Height="760" MinHeight="650" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="DialogTitle" Text="编辑快捷命令" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="把常用命令、软件或脚本保存为可执行按钮" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="按钮名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel></Grid>
            <TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>
            <TextBlock Text="执行类型" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ExecutionTypeComboBox" ItemsSource="{Binding CommandTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ExecutionType}" SelectionChanged="ExecutionType_SelectionChanged" Margin="0,5,0,13"/>

            <StackPanel x:Name="CmdPanel"><TextBlock Text="CMD 命令" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="95" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,13" ToolTip="例如：ipconfig /all"/></StackPanel>
            <StackPanel x:Name="ProgramPanel" Visibility="Collapsed"><TextBlock Text="软件路径" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择软件…" Click="BrowseProgram_Click"/></Grid></StackPanel>
            <StackPanel x:Name="BatchPanel" Visibility="Collapsed"><TextBlock Text="BAT / CMD 脚本路径" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding BatchPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择脚本…" Click="BrowseBatch_Click"/></Grid></StackPanel>
            <StackPanel x:Name="ArgumentsPanel" Visibility="Collapsed"><TextBlock Text="启动参数（可选）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,13"/></StackPanel>

            <TextBlock Text="工作目录（可选）" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择目录…" Click="BrowseWorkingDirectory_Click"/></Grid>
            <TextBlock Text="用途和说明" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="85" VerticalContentAlignment="Top" Margin="0,5,0,13"/>

            <Border Background="#FFF6E7" CornerRadius="9" Padding="14"><StackPanel>
                <TextBlock Text="执行选项" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel><CheckBox Content="执行前再次确认" IsChecked="{Binding ConfirmBeforeRun}" Margin="0,0,24,8"/><CheckBox Content="以管理员身份运行" IsChecked="{Binding RunAsAdministrator}" Margin="0,0,24,8"/><CheckBox x:Name="KeepWindowCheckBox" Content="执行后保留命令窗口" IsChecked="{Binding KeepWindowOpen}" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="请只保存你理解并信任的命令。管理员命令能够修改系统配置。" Foreground="#B56A25" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
