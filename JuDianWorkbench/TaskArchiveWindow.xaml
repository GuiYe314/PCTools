<Window x:Class="JuDianWorkbench.TaskArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务归档" Width="760" Height="540" MinWidth="650" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><TextBlock Text="任务归档" FontSize="23" FontWeight="SemiBold"/><Border Background="#EEF3FF" CornerRadius="8" Padding="8,3" Margin="10,1,0,0"><TextBlock Text="{Binding ArchivedTaskCount, StringFormat={}{0} 项}" Foreground="{StaticResource AccentBrush}"/></Border></StackPanel><TextBlock Text="归档任务不会显示在正常任务列表中，可以随时恢复" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="0">
            <ListBox x:Name="ArchiveList" ItemsSource="{Binding ArchivedTasks}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,10,0"/><TextBlock Text="{Binding PlannedDateTimeText, StringFormat=计划：{0}}" Foreground="#8B96A8" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding ArchivedAt, StringFormat=归档：MM-dd HH:mm}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="恢复" Tag="{Binding}" Click="Restore_Click" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
</Window>
