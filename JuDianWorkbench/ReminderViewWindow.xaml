<Window x:Class="JuDianWorkbench.ReminderViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务提醒视图" Width="900" Height="610" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="任务提醒视图" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="集中查看已启用提醒的任务" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="FilterComboBox" Grid.Column="1" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Center"><ComboBoxItem Content="全部提醒" Tag="All" IsSelected="True"/><ComboBoxItem Content="已逾期" Tag="Overdue"/><ComboBoxItem Content="未来 7 天" Tag="Next7Days"/><ComboBoxItem Content="已提醒" Tag="Sent"/></ComboBox></Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="全部" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AllCountText" Text="0" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="已逾期" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OverdueCountText" Text="0" FontSize="22" Foreground="#D05A4E" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="未来 7 天" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NextWeekCountText" Text="0" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="已提醒" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SentCountText" Text="0" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="0">
            <ListBox x:Name="ReminderList" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Content}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/><TextBlock Text="{Binding SubTaskSummaryText}" Foreground="#8B96A8" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PlannedDateTimeText, StringFormat=到期：{0}}"/><TextBlock Text="{Binding ReminderAt, StringFormat=提醒：MM-dd HH:mm}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="#EEF3FF" CornerRadius="8" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding ReminderStateText}" Foreground="{StaticResource AccentBrush}"/></Border><Button Grid.Column="3" Content="查看任务" Tag="{Binding}" Click="OpenTask_Click" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Border>
        <Button Grid.Row="3" Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
</Window>
