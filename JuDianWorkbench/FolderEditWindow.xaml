<Window x:Class="JuDianWorkbench.FolderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑文件夹" Width="590" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock x:Name="DialogTitle" Text="编辑文件夹" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="维护文件夹的路径、用途和说明" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="文件夹路径" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择…" Click="Browse_Click"/></Grid>
            <TextBlock Text="显示名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>
            <TextBlock Text="用途" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Category}" Margin="0,5,0,13"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel></Grid>
            <CheckBox Content="收藏到工作台" IsChecked="{Binding IsFavorite}" Margin="0,2,0,13"/>
            <TextBlock Text="详细备注" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="105" VerticalContentAlignment="Top" Margin="0,5,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,9,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
