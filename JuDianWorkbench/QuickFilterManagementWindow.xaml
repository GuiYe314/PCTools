<Window x:Class="JuDianWorkbench.QuickFilterManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理快捷筛选标签" Width="650" Height="560" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="管理快捷筛选标签" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="勾选要固定到页面的标签；拖动条目或使用按钮调整顺序。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ListBox x:Name="FilterList" Grid.Row="1" ItemsSource="{Binding}" AllowDrop="True" PreviewMouseLeftButtonDown="FilterList_PreviewMouseLeftButtonDown" MouseMove="FilterList_MouseMove" Drop="FilterList_Drop" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate><Border Background="#F5F7FA" CornerRadius="9" Padding="13" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="10" Background="{Binding Color}" CornerRadius="5" Margin="0,0,11,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Tags, StringFormat=数据标签：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="2" Content="固定" IsChecked="{Binding IsPinned}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Button Content="上移" Click="MoveUp_Click" Margin="0,0,8,0"/><Button Content="下移" Click="MoveDown_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存布局" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
