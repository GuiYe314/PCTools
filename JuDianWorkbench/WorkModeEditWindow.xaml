<Window x:Class="JuDianWorkbench.WorkModeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑工作模式" Width="820" Height="700" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock x:Name="DialogTitle" Text="新建工作模式" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="从程序库选择启动项，并按实际工作顺序排列" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,14"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="模式名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="说明" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/></StackPanel></Grid>
            <StackPanel Orientation="Horizontal"><CheckBox Content="固定到工作台" IsChecked="{Binding IsPinned}"/><CheckBox Content="启动前显示确认清单" IsChecked="{Binding ConfirmBeforeRun}" Margin="22,0,0,0"/><CheckBox Content="某项失败后停止" IsChecked="{Binding StopOnFailure}" Margin="22,0,0,0"/></StackPanel>
        </StackPanel></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}" Padding="0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="程序库" FontSize="16" FontWeight="SemiBold" Margin="16,14,16,8"/><ListBox x:Name="AvailableProgramList" ItemsSource="{Binding Programs, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TargetType}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><Button Content="添加 →" Click="AddStep_Click" Margin="0,0,0,8"/><Button Content="← 移除" Click="RemoveStep_Click"/></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="启动顺序" FontSize="16" FontWeight="SemiBold" Margin="16,14,16,8"/><ListBox x:Name="StepList" Grid.Row="1" ItemsSource="{Binding Steps}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,7"><TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold"/><TextBlock Text="{Binding DelayAfterSeconds, StringFormat=启动后等待 {0} 秒}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="2" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="上移" Click="MoveUp_Click" Padding="10,6"/><Button Grid.Column="1" Content="下移" Click="MoveDown_Click" Padding="10,6" Margin="7,0,0,0"/><TextBlock Grid.Column="3" Text="等待" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox Grid.Column="4" ItemsSource="{Binding DelayOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedItem.DelayAfterSeconds, ElementName=StepList}" SelectionChanged="Delay_SelectionChanged" Width="80"/></Grid></Grid></Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存工作模式" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
