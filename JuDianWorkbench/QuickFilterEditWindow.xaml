<Window x:Class="JuDianWorkbench.QuickFilterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷筛选标签" Width="620" Height="650" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock x:Name="DialogTitle" Text="新建快捷筛选标签" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="保存一组筛选条件，并固定到当前功能页面。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="标签名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="标签颜色" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding ColorOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Color}" Margin="0,5,0,13"/></StackPanel></Grid>
            <CheckBox Content="固定到当前页面" IsChecked="{Binding IsPinned}" Margin="0,0,0,13"/>
            <StackPanel x:Name="CategoryPanel"><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Categories, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Category}" Margin="0,5,0,13"/></StackPanel>
            <TextBlock Text="数据标签（逗号分隔，可留空）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,6"/>
            <TextBlock x:Name="AvailableTagsText" Foreground="#8B96A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,13"/>
            <StackPanel x:Name="TagMatchPanel"><TextBlock Text="多个数据标签的匹配方式" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding TagMatchModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding TagMatchMode}" Margin="0,5,0,13"/></StackPanel>
            <StackPanel x:Name="StatusPanel"><TextBlock Text="状态" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Status}" Margin="0,5,0,13"/></StackPanel>
            <StackPanel x:Name="TypePanel"><TextBlock Text="类型" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding TypeOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Type}" Margin="0,5,0,13"/></StackPanel>
            <StackPanel x:Name="PriorityPanel"><TextBlock Text="优先级" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding PriorityOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Priority}" Margin="0,5,0,13"/></StackPanel>
            <StackPanel x:Name="ReminderPanel"><TextBlock Text="提醒条件" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding ReminderModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ReminderMode}" Margin="0,5,0,13"/></StackPanel>
            <Grid x:Name="FolderModesPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="收藏条件" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding FavoriteModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding FavoriteMode}" Margin="0,5,0,13"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Unity 条件" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding UnityModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding UnityMode}" Margin="0,5,0,13"/></StackPanel></Grid>
            <StackPanel x:Name="AdministratorPanel"><TextBlock Text="运行权限" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding AdministratorModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding AdministratorMode}" Margin="0,5,0,13"/></StackPanel>
            <Border Background="#EEF3FF" CornerRadius="9" Padding="13"><TextBlock Text="保存后标签会固定在页面筛选栏。单击应用筛选，右键可以再次编辑或删除。" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/></Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="DeleteButton" Content="删除标签" Click="Delete_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button Content="管理固定与排序" Click="ManageLayout_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存筛选" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/></StackPanel></Grid>
    </Grid>
</Window>
