                        <Border Grid.Column="2" Style="{StaticResource PanelCard}"><Grid DataContext="{Binding SelectedCommand}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="命令详情" FontSize="17" FontWeight="SemiBold"/><Border Background="#EEF3FF" CornerRadius="9" Padding="14" Margin="0,14,0,14"><StackPanel><TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Category, StringFormat=分类：{0}}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="执行类型" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ExecutionType}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="运行权限" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RunModeText}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBlock Text="执行内容" Foreground="{StaticResource MutedBrush}"/><Border Background="#182033" CornerRadius="7" Padding="12" Margin="0,5,0,14"><TextBlock Text="{Binding TargetSummary}" Foreground="#E6EAF2" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"/></Border>
                                <TextBlock Text="标签" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Tags, TargetNullValue=暂无标签}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="启动参数" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Arguments, TargetNullValue=无}" Margin="0,5,0,14" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
                                <TextBlock Text="工作目录" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding WorkingDirectory, TargetNullValue=自动选择}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                                <TextBlock Text="用途说明" Foreground="{StaticResource MutedBrush}"/><Border Background="#F5F7FA" CornerRadius="7" Padding="12" Margin="0,5,0,14" MinHeight="65"><TextBlock Text="{Binding Description, TargetNullValue=暂无说明}" TextWrapping="Wrap"/></Border>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="执行次数" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RunCount}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="最后执行" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LastRunText}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
                            </StackPanel></ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="删除" Click="DeleteCommand_Click" Margin="0,0,8,0"/><Button Content="编辑" Click="EditCommand_Click" Margin="0,0,8,0"/><Button Content="立即执行" Style="{StaticResource PrimaryButton}" Click="RunSelectedCommand_Click"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                </Grid>

                <Grid x:Name="GitHubPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="GitHub 热门项目" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="发现近期高星开源项目，并与上次结果比较热度变化" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GitHubPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding SelectedGitHubPeriodDays}" VerticalAlignment="Center" ToolTip="项目创建时间范围" SelectionChanged="GitHubFilter_SelectionChanged"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding GitHubLanguages}" SelectedItem="{Binding SelectedGitHubLanguage}" VerticalAlignment="Center" ToolTip="编程语言" SelectionChanged="GitHubFilter_SelectionChanged"/>
                        <Button x:Name="GitHubRefreshButton" Grid.Column="5" Content="检测热门项目" Style="{StaticResource PrimaryButton}" Click="RefreshGitHubTrending_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#EEF3FF" CornerRadius="9" Padding="12,7"><TextBlock Text="{Binding GitHubTrendCount, StringFormat=当前榜单：{0} 个项目}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
                        <Border Grid.Column="2" Background="#FFF6E7" CornerRadius="9" Padding="12,7"><TextBlock Text="{Binding GitHubNewCount, StringFormat=新上榜：{0} 个}" Foreground="#B56A25" FontWeight="SemiBold"/></Border>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock x:Name="GitHubStatusText" Text="公开仓库，无需登录" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding GitHubLastUpdatedText}" Foreground="#8B96A8" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelCard}" Padding="0"><ListBox x:Name="GitHubProjectList" ItemsSource="{Binding GitHubProjects}" SelectedItem="{Binding SelectedGitHubProject}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RankText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding DisplayDescription}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Language}" Foreground="#8B96A8" FontSize="12"/><TextBlock Text="  ★ " Foreground="#D69E2E" FontSize="12"/><TextBlock Text="{Binding Stars, StringFormat=N0}" Foreground="#8B96A8" FontSize="12"/><TextBlock Text="  ·  " Foreground="#B1B8C4"/><TextBlock Text="{Binding StarChangeText}" Foreground="#8B96A8" FontSize="12"/></StackPanel></StackPanel><Border Grid.Column="2" Background="#EEF3FF" CornerRadius="8" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding TrendStatus}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}"><Grid DataContext="{Binding SelectedGitHubProject}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="项目详情" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding FullName}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplayDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14" TextWrapping="Wrap"/></StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,16"><Border Background="#F5F7FA" CornerRadius="8" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="Stars" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Stars, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#F5F7FA" CornerRadius="8" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="Forks" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Forks, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#F5F7FA" CornerRadius="8" Padding="10" Margin="6,0,0,0"><StackPanel><TextBlock Text="Issues" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding OpenIssues, StringFormat=N0}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="开发语言" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Column="1" Text="{Binding Language}" Margin="0,4"/><TextBlock Grid.Row="1" Text="开源协议" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License}" Margin="0,4"/><TextBlock Grid.Row="2" Text="创建时间" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Margin="0,4"/><TextBlock Grid.Row="3" Text="最近更新" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Margin="0,4"/><TextBlock Grid.Row="4" Text="热度变化" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StarChangeText}" Margin="0,4" Foreground="{StaticResource AccentBrush}"/><TextBlock Grid.Row="5" Text="主题" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Topics}" Margin="0,4" TextWrapping="Wrap"/></Grid>
                            </StackPanel></ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="GitHubTranslateButton" Content="{Binding TranslationActionText}" Click="TranslateGitHubDescription_Click" Margin="0,0,8,0"/><Button Content="复制克隆地址" Click="CopyGitHubCloneUrl_Click" Margin="0,0,8,0"/><Button Content="打开 GitHub" Style="{StaticResource PrimaryButton}" Click="OpenGitHubProject_Click"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="FileSharePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18"><TextBlock Text="局域网文件共享" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="启动后，同一局域网设备可通过浏览器上传和下载文件" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}"><StackPanel>
                                <TextBlock Text="服务设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <TextBlock Text="访问端口" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="FileSharePortTextBox" Margin="0,5,0,12"/>
                                <TextBlock Text="访问密码" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="FileSharePasswordBox" Margin="0,5,0,12" ToolTip="至少 4 个字符"/>
                                <TextBlock Text="共享文件保存目录" Foreground="{StaticResource MutedBrush}"/>
                                <Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FileShareStoragePathTextBox"/><Button Grid.Column="2" Content="选择…" Click="BrowseFileShareStorage_Click"/></Grid>
                                <StackPanel Orientation="Horizontal"><Button x:Name="StartFileShareButton" Content="启动文件共享" Style="{StaticResource PrimaryButton}" Click="StartFileShare_Click"/><Button x:Name="StopFileShareButton" Content="停止服务" Click="StopFileShare_Click" Margin="8,0,0,0" IsEnabled="False"/></StackPanel>
                            </StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}"><StackPanel>
                                <TextBlock Text="服务状态" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FileShareStatusText" Text="尚未启动" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,8"/>
                                <TextBlock Text="访问地址" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,6"/>
                                <TextBlock x:Name="FileShareAddressesText" Text="启动服务后显示" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="OpenFileShareButton" Content="在本机浏览器打开" Click="OpenFileShare_Click" IsEnabled="False"/><Button x:Name="CopyFileShareAddressButton" Content="复制访问地址" Click="CopyFileShareAddress_Click" Margin="8,0,0,0" IsEnabled="False"/></StackPanel>
                                <TextBlock Text="首次从其他设备访问失败时，请允许 Windows 防火墙中的专用网络访问。当前服务仅适合可信局域网，不要映射到公网。" Foreground="#B56A25" TextWrapping="Wrap" Margin="0,18,0,0"/>
                            </StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SystemNetworkPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="系统与网络" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="查看本机状态、网络地址，并管理 IPv4 配置" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshSystemButton" Content="刷新全部信息" Style="{StaticResource PrimaryButton}" Click="RefreshSystemNetwork_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="本地网络" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LocalNetworkStatusText" Text="等待检测" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="互联网" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InternetStatusText" Text="等待检测" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="公网 IP" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PublicIpText" Text="未查询" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="IP 所在地" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LocationText" Text="未查询" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="电脑配置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="计算机名" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Column="1" x:Name="ComputerNameText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="操作系统" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="OperatingSystemText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="处理器" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="CpuText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Text="内存" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="MemoryText" Text="-" Margin="0,4"/>
                                            <TextBlock Grid.Row="4" Text="体系结构" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="ArchitectureText" Text="-" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelCard}" Margin="0,16,0,20">
                                    <StackPanel>
                                        <TextBlock Text="硬件详情" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Windows" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Column="1" x:Name="WindowsVersionText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="CPU 详情" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuDetailsText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="内存使用" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemoryDetailsText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Text="显卡" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="GraphicsText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Text="显卡驱动" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="GraphicsDriverText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="5" Text="主显示器" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="DisplayText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="6" Text="主板" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="MotherboardText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="7" Text="BIOS" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="7" Grid.Column="1" x:Name="BiosText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="8" Text="本地磁盘" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="8" Grid.Column="1" x:Name="DrivesText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="9" Text="运行时长" Foreground="{StaticResource MutedBrush}" Margin="0,4"/><TextBlock Grid.Row="9" Grid.Column="1" x:Name="UptimeText" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="网卡与本地 IP" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="选择网卡后显示它当前使用的地址。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,10"/>
                                        <ComboBox x:Name="NetworkAdapterComboBox" DisplayMemberPath="DisplayName" SelectionChanged="NetworkAdapter_SelectionChanged"/>
                                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="网卡说明" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Grid.Column="1" x:Name="AdapterDescriptionText" Text="-" Margin="0,3" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="本地 IPv4" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="LocalIpText" Text="-" Margin="0,3"/>
                                            <TextBlock Grid.Row="2" Text="默认网关" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="GatewayText" Text="-" Margin="0,3"/>
                                            <TextBlock Grid.Row="3" Text="DNS" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="DnsText" Text="-" Margin="0,3" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Text="IP 方式" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="CurrentIpModeText" Text="-" Margin="0,3"/>
                                        </Grid>
                                        <TextBlock x:Name="IspText" Text="运营商：未查询" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource PanelCard}" Margin="0,16,0,20">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="IPv4 设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="在弹窗中选择自动获取或静态 IP。应用后网络会短暂断开，并由 Windows 要求管理员确认。" Foreground="#B56A25" Margin="0,7,20,0" TextWrapping="Wrap"/></StackPanel>
                                        <Button Grid.Column="1" Content="修改 IP 设置" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="OpenIpSettings_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,18"><TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="管理软件名称、功能入口、启动行为和本地数据" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}" VerticalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="软件名称" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="窗口和左侧顶部显示的名称" Foreground="{StaticResource MutedBrush}" Margin="0,7,16,8"/><TextBlock x:Name="CurrentApplicationNameText" Text="聚点工作台" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="修改名称" Style="{StaticResource PrimaryButton}" Click="EditApplicationName_Click" VerticalAlignment="Bottom"/></Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}" VerticalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="功能管理" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="控制左侧功能入口的显示与隐藏" Foreground="{StaticResource MutedBrush}" Margin="0,7,16,8"/><TextBlock x:Name="EnabledFeatureCountText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></StackPanel><Button Grid.Column="1" Content="管理功能" Style="{StaticResource PrimaryButton}" Click="ManageFeatures_Click" VerticalAlignment="Bottom"/></Grid></Border>
                        </Grid>
                        <Border Style="{StaticResource PanelCard}" VerticalAlignment="Top" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Windows 开机启动" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StartupDescriptionText" Text="登录当前 Windows 用户后自动运行本软件。此设置仅影响当前用户，不需要管理员权限。" Foreground="{StaticResource MutedBrush}" Margin="0,7,20,0" TextWrapping="Wrap"/><TextBlock x:Name="StartupStatusText" Text="" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><CheckBox x:Name="StartWithWindowsCheckBox" Content="开机自动启动" IsChecked="{Binding Settings.StartWithWindows}" FontWeight="SemiBold" Margin="0,3,0,12"/><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveStartupSettings_Click"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource PanelCard}" VerticalAlignment="Top" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="数据自动备份" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="每天首次启动时自动备份文件夹、任务和设置数据。" Foreground="{StaticResource MutedBrush}" Margin="0,7,20,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox Content="启用每日备份" IsChecked="{Binding Settings.AutoBackupEnabled}" VerticalAlignment="Center"/><TextBlock Text="保留" Foreground="{StaticResource MutedBrush}" Margin="20,0,7,0" VerticalAlignment="Center"/><ComboBox Width="75" ItemsSource="{Binding BackupRetentionOptions}" SelectedItem="{Binding Settings.BackupRetentionCount}"/><TextBlock Text="份" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="BackupStatusText" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Button Content="保存备份设置" Style="{StaticResource PrimaryButton}" Click="SaveBackupSettings_Click" Margin="0,0,0,8"/><Button Content="管理备份与恢复" Click="ShowBackups_Click"/></StackPanel></Grid></Border>
                        <Border Style="{StaticResource PanelCard}" VerticalAlignment="Top" Margin="0,16,0,20"><StackPanel><TextBlock Text="本地数据" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="数据保存在当前 Windows 用户的本地应用数据目录。" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><TextBlock Text="运行日志按日期保存，发生异常时可用于排查。" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="24,0"/></Border>
        </Grid>
    </Grid>
</Window>
