<Window x:Class="JuDianWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:JuDianWorkbench.Models"
        Title="聚点工作台" Width="1220" Height="790" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate x:Key="TreeNodeTemplate" DataType="{x:Type models:FolderTreeNode}">
            <TextBlock Text="{Binding Name}" Padding="3"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,22,12,25">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="ApplicationInitialText" Text="聚" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ApplicationNameText" Text="聚点工作台" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <RadioButton x:Name="DashboardNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="▦  工作台" Tag="Dashboard" Checked="Navigation_Checked" IsChecked="True"/>
                    <TextBlock Text="个人管理" Foreground="#71809A" FontSize="11" FontWeight="SemiBold" Margin="22,16,0,5"/>
                    <RadioButton x:Name="FoldersNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="▣  文件夹管理" Tag="Folders" Checked="Navigation_Checked"/>
                    <RadioButton x:Name="TasksNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="☑  任务管理" Tag="Events" Checked="Navigation_Checked"/>
                    <RadioButton x:Name="WorkModesNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="◫  工作模式" Tag="WorkModes" Checked="Navigation_Checked"/>
                    <TextBlock Text="工具" Foreground="#71809A" FontSize="11" FontWeight="SemiBold" Margin="22,16,0,5"/>
                    <RadioButton x:Name="CommandNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="▶  命令中心" Tag="Commands" Checked="Navigation_Checked"/>
                    <RadioButton x:Name="FileShareNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="⇅  文件共享" Tag="FileShare" Checked="Navigation_Checked"/>
                    <RadioButton x:Name="SystemNetworkNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="◉  系统与网络" Tag="SystemNetwork" Checked="Navigation_Checked"/>
                    <TextBlock Text="发现" Foreground="#71809A" FontSize="11" FontWeight="SemiBold" Margin="22,16,0,5"/>
                    <RadioButton x:Name="GitHubNavButton" Style="{StaticResource NavButton}" GroupName="Navigation" Content="⌁  GitHub 热门" Tag="GitHub" Checked="Navigation_Checked"/>
                </StackPanel>
                </ScrollViewer>
                <RadioButton x:Name="SettingsNavButton" Grid.Row="2" Style="{StaticResource NavButton}" GroupName="Navigation" Content="⚙  设置" Tag="Settings" Checked="Navigation_Checked" Margin="8,3,8,16"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentPageTitleText" Text="当前位置 · 工作台" FontSize="13" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Grid x:Name="GlobalSearchContainer" Grid.Column="2" Visibility="Collapsed">
                    <TextBox x:Name="GlobalSearchBox" Text="" VerticalContentAlignment="Center" ToolTip="搜索当前页面"/>
                    <TextBlock x:Name="SearchPlaceholderText" IsHitTestVisible="False" Text="搜索当前页面…" Foreground="#98A2B3" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    </Grid>
                    <Button Grid.Column="4" Content="＋ 快速任务" Style="{StaticResource PrimaryButton}" Click="QuickEvent_Click" ToolTip="快捷键 Ctrl+N"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="工作台" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="继续手头工作，或快速启动常用功能" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="本地优先 · 数据保存在此电脑" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <Button Content="＋  新建任务" Style="{StaticResource DashboardActionButton}" Click="QuickEvent_Click" Margin="0,0,10,0"/>
                            <Button Content="▣  添加文件夹" Style="{StaticResource DashboardActionButton}" Click="NewFolder_Click" Margin="0,0,10,0"/>
                            <Button Content="▶  添加命令" Style="{StaticResource DashboardActionButton}" Click="NewCommand_Click" Margin="0,0,10,0"/>
                            <Button Content="◫  工作模式" Style="{StaticResource DashboardActionButton}" Tag="WorkModes" Click="NavigateToFeature_Click" Margin="0,0,10,0"/>
                            <Button Content="⇅  文件共享" Style="{StaticResource DashboardActionButton}" Tag="FileShare" Click="NavigateToFeature_Click"/>
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="待办任务" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding OpenTaskCount}" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="{Binding OverdueTaskCount, StringFormat={}{0} 个已逾期}" Foreground="#B56A25" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="收藏文件夹" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FavoriteFolderCount}" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="随时快速打开" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="快捷命令" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CommandCount}" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="保存的一键操作" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="工作模式" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding WorkModeCount}" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="组合启动工作环境" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,18"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="常用工作模式" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="管理工作模式" Tag="WorkModes" Click="NavigateToFeature_Click" Padding="10,5"/></Grid><Grid><ItemsControl ItemsSource="{Binding PinnedWorkModes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="RunWorkMode_Click" Padding="14,9" Margin="0,0,8,7" ToolTip="{Binding DetailToolTipText}"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="还没有固定的工作模式，可从“管理工作模式”创建"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="8,18"/><Style.Triggers><DataTrigger Binding="{Binding PinnedWorkModes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="继续工作" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="查看全部任务" Tag="Events" Click="NavigateToFeature_Click" Padding="10,5"/></Grid><Grid><ListBox ItemsSource="{Binding DashboardTasks}" MaxHeight="260" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlannedDateTimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="#EEF3FF" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="12"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="没有待办任务，可以从上方快速新建"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="运行状态" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="局域网文件共享"/><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=FileShareStatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文件夹路径"/><TextBlock Grid.Column="1" Text="{Binding InvalidFolderCount, StringFormat={}{0} 个失效}" Foreground="#B56A25"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="数据存储"/><TextBlock Grid.Column="1" Text="本机" Foreground="#27835E" FontWeight="SemiBold"/></Grid></StackPanel></Border>
                                <Border Style="{StaticResource PanelCard}"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="常用文件夹" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="文件夹管理" Tag="Folders" Click="NavigateToFeature_Click" Padding="10,5"/></Grid><ListBox ItemsSource="{Binding FavoriteFolders}" MaxHeight="150" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="打开" Tag="{Binding}" Click="OpenFolderFromList_Click" Padding="9,4"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="FoldersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="文件夹管理" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="记录用途、备注并浏览目录结构" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ 添加文件夹" Style="{StaticResource PrimaryButton}" Click="NewFolder_Click" ToolTip="快捷键 Ctrl+N"/><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0"><ComboBox Width="150" ItemsSource="{Binding FolderCategoryFilters}" SelectedItem="{Binding SelectedFolderCategory}" ToolTip="按分类筛选"/><ComboBox Width="135" Margin="9,0,0,0" ItemsSource="{Binding FolderStatusFilters}" SelectedItem="{Binding SelectedFolderStatus}" ToolTip="按路径状态筛选"/><CheckBox Content="只看收藏" IsChecked="{Binding FavoriteFoldersOnly}" VerticalAlignment="Center" Margin="14,0,0,0"/><Button Content="检查全部路径" Click="CheckAllFolders_Click" Padding="11,6" Margin="14,0,0,0"/></StackPanel><DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"><TextBlock DockPanel.Dock="Left" Text="快捷筛选" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/><Button DockPanel.Dock="Left" Content="全部" Tag="Folders" Click="ClearQuickFilter_Click" Padding="10,5" Margin="0,0,7,0"/><Button DockPanel.Dock="Right" Content="＋ 新建筛选" Tag="Folders" Click="NewQuickFilter_Click" Padding="10,5"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FolderQuickFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="ApplyQuickFilter_Click" PreviewMouseRightButtonUp="EditQuickFilter_RightClick" Padding="11,5" Margin="0,0,7,0" ToolTip="单击筛选，右键编辑"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{Binding Color}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{Binding Color}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="#20293A"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Grid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelCard}" Padding="0"><ListBox x:Name="FolderList" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" SelectionChanged="FolderList_SelectionChanged" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid Margin="14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text=" ★" Foreground="#E5A526" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/></StackPanel><TextBlock Text="{Binding Purpose}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding Path}" Foreground="#8B96A8" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EEF3FF" Padding="7,4" CornerRadius="8"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="12"/></Border><Button Content="收藏/取消" Tag="{Binding}" Click="ToggleFolderFavorite_Click" Margin="8,0,0,0" Padding="10,5"/><Button Content="打开" Tag="{Binding}" Click="OpenFolderFromList_Click" Margin="8,0,0,0" Padding="10,5"/><Button Content="打开 Unity" Tag="{Binding}" Click="OpenUnityProject_Click" Margin="8,0,0,0" Padding="10,5" Visibility="{Binding HasUnityProjects, Converter={StaticResource BoolToVisibility}}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                        <TextBlock Grid.Column="0" Text="没有符合条件的文件夹&#x0a;可清除搜索或添加一个新文件夹" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Folders.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="文件夹资料" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <ScrollViewer x:Name="FolderDisplayPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedFolder}">
                                <Border Background="#EEF3FF" CornerRadius="9" Padding="15" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Purpose}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="★ 已收藏" Foreground="#C98B11" VerticalAlignment="Center" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/></Grid></Border>
                                <TextBlock Text="文件夹位置" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Path}" FontSize="14" Margin="0,5,0,15" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Category}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="状态" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBlock Text="标签" Foreground="{StaticResource MutedBrush}"/><Border Background="#F5F7FA" CornerRadius="7" Padding="10,7" Margin="0,5,0,15"><TextBlock Text="{Binding Tags, TargetNullValue=暂无标签}" TextWrapping="Wrap"/></Border>
                                <TextBlock Text="详细备注" Foreground="{StaticResource MutedBrush}"/><Border Background="#F5F7FA" CornerRadius="7" Padding="12" Margin="0,5,0,16" MinHeight="70"><TextBlock Text="{Binding Notes, TargetNullValue=暂无备注}" TextWrapping="Wrap"/></Border>
                                <Border Background="#F5F7FA" CornerRadius="9" Padding="12" Margin="0,0,0,15"><StackPanel><TextBlock Text="文件夹读取结果" FontWeight="SemiBold"/><TextBlock Text="{Binding ReadSummaryText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding UnityProjectSummaryText}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/><ItemsControl ItemsSource="{Binding DetectedUnityProjects}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding ProjectPath, StringFormat=• {0}}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                <TextBlock Text="目录结构" FontWeight="SemiBold" Margin="0,2,0,7"/>
                                <TreeView ItemsSource="{Binding DataContext.FolderTree, RelativeSource={RelativeSource AncestorType=Window}}" Height="210" TreeViewItem.Expanded="FolderTreeItem_Expanded" PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown" PreviewMouseDoubleClick="FolderTree_MouseDoubleClick">
                                    <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type models:FolderTreeNode}" ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="单击选中，双击展开或收起，右键打开"><TextBlock Text="{Binding Icon}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></HierarchicalDataTemplate></TreeView.Resources>
                                </TreeView>
                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="FolderEditPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel DataContext="{Binding SelectedFolder}">
                                <TextBlock Text="路径" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择…" Click="BrowseFolder_Click"/></Grid>
                                <TextBlock Text="显示名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
                                <TextBlock Text="用途" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding DataContext.FolderCategories, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Category}" Margin="0,5,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/></StackPanel></Grid>
                                <CheckBox Content="收藏到工作台" IsChecked="{Binding IsFavorite}" Margin="0,2,0,12"/>
                                <TextBlock Text="详细备注" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top" Margin="0,5,0,14"/>
                                <TextBlock Text="目录结构（展开节点时加载）" FontWeight="SemiBold" Margin="0,5,0,7"/>
                                <TreeView ItemsSource="{Binding DataContext.FolderTree, RelativeSource={RelativeSource AncestorType=Window}}" Height="170" TreeViewItem.Expanded="FolderTreeItem_Expanded" PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown" PreviewMouseDoubleClick="FolderTree_MouseDoubleClick">
                                    <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type models:FolderTreeNode}" ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="单击选中，双击展开或收起，右键打开"><TextBlock Text="{Binding Icon}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></HierarchicalDataTemplate></TreeView.Resources>
                                </TreeView>
                            </StackPanel></ScrollViewer>
                            <StackPanel x:Name="FolderDisplayActions" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="复制路径" Click="CopyPath_Click" Margin="0,0,8,0"/><Button Content="移除" Click="DeleteFolder_Click" Margin="0,0,8,0"/><Button Content="编辑" Click="EditFolder_Click" Margin="0,0,8,0"/><Button x:Name="ReadFolderButton" Content="读取文件夹" Click="ReadFolder_Click" Margin="0,0,8,0"/><Button x:Name="OpenUnityProjectButton" Content="打开 Unity 项目" Style="{StaticResource PrimaryButton}" Click="OpenUnityProject_Click" Visibility="{Binding SelectedFolder.HasUnityProjects, Converter={StaticResource BoolToVisibility}}"/></StackPanel>
                            <StackPanel x:Name="FolderEditActions" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="Collapsed"><Button Content="取消" Click="CancelFolderEdit_Click" Margin="0,0,8,0"/><Button Content="移除" Click="DeleteFolder_Click" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveFolder_Click"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                </Grid>

                <Grid x:Name="EventsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
