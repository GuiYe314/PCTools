<Window x:Class="JuDianWorkbench.FeatureManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="功能管理" Width="620" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Border Style="{StaticResource PanelCard}" Margin="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="左侧功能管理" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="关闭后仅隐藏对应入口和页面，不会删除任何数据；“设置”入口始终保留。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1">
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="工作台" FontWeight="SemiBold"/><TextBlock Text="文件夹和任务概览" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="DashboardCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="文件夹管理" FontWeight="SemiBold"/><TextBlock Text="文件夹收藏、目录结构和路径检查" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="FoldersCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="任务管理" FontWeight="SemiBold"/><TextBlock Text="任务、子任务、重复计划和提醒" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="TasksCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="命令中心" FontWeight="SemiBold"/><TextBlock Text="CMD 命令、软件和 BAT 脚本的一键入口" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="CommandsCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GitHub 热门" FontWeight="SemiBold"/><TextBlock Text="热门开源项目检测与翻译" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="GitHubCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="文件共享" FontWeight="SemiBold"/><TextBlock Text="启动局域网 Web 上传和下载服务" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="FileShareCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
                <Border Background="#F5F7FA" CornerRadius="9" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="系统与网络" FontWeight="SemiBold"/><TextBlock Text="电脑配置、联网检测和 IP 设置" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="SystemNetworkCheckBox" Grid.Column="1" Content="显示" VerticalAlignment="Center"/></Grid></Border>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="全部显示" Click="ShowAll_Click" Margin="0,0,8,0"/><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
