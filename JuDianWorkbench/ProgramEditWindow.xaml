<Window x:Class="JuDianWorkbench.ProgramEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序库启动项" Width="650" Height="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock x:Name="DialogTitle" Text="添加启动项" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="程序、网页和文件夹都可以加入工作模式" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="名称" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel>
                </Grid>
                <TextBlock Text="启动项类型" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="TargetTypeComboBox" ItemsSource="{Binding TargetTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding TargetType}" SelectionChanged="TargetType_SelectionChanged" Margin="0,5,0,13"/>
                <TextBlock x:Name="TargetLabel" Text="程序路径" Foreground="{StaticResource MutedBrush}"/>
                <Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/><Button x:Name="BrowseTargetButton" Grid.Column="2" Content="选择…" Click="BrowseTarget_Click"/></Grid>
                <StackPanel x:Name="ProgramOptionsPanel">
                    <TextBlock Text="启动参数（可选）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13" ToolTip="Unity 项目示例：-projectPath &quot;D:\项目目录&quot;"/>
                    <TextBlock Text="工作目录（可选）" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="选择目录…" Click="BrowseWorkingDirectory_Click"/></Grid>
                    <StackPanel Orientation="Horizontal"><CheckBox Content="程序已运行时跳过重复启动" IsChecked="{Binding SkipIfRunning}"/><CheckBox Content="使用管理员权限" IsChecked="{Binding RunAsAdministrator}" Margin="24,0,0,0"/></StackPanel>
                </StackPanel>
                <Border Background="#EEF3FF" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="网页仅允许 http/https 地址。添加 Unity Editor 时，可在启动参数中填写 -projectPath 指定项目。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
            </StackPanel></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存启动项" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
