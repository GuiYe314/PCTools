<Window x:Class="JuDianWorkbench.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务" Width="700" Height="790" MinHeight="650" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock x:Name="DialogTitle" Text="编辑任务" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="设置任务内容、状态以及处理注释" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="任务标题" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>
            <TextBlock Text="任务说明" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="95" VerticalContentAlignment="Top" Margin="0,5,0,13"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="任务类型" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Types, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Type}" Margin="0,5,0,13"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="重要程度" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Priorities, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Priority}" Margin="0,5,0,13"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="任务状态" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Statuses, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Status}" Margin="0,5,0,13"/></StackPanel>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="计划日期" Foreground="{StaticResource MutedBrush}"/><DatePicker SelectedDate="{Binding OccurredAt}" Margin="0,5,0,13"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="计划时间（HH:mm）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding PlannedTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/></StackPanel></Grid>
            <TextBlock Text="关联文件夹" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Folders, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FolderId}" Margin="0,5,0,13"/>
            <TextBlock Text="标签（逗号分隔）" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13"/>
            <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,2,0,13"><StackPanel>
                <TextBlock Text="提醒与重复" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox Content="启用任务提醒" IsChecked="{Binding ReminderEnabled}" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding ReminderOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding ReminderMinutesBefore}"/></Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="重复方式" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="RepeatTypeComboBox" ItemsSource="{Binding RepeatTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding RepeatType}" SelectionChanged="RepeatType_SelectionChanged" Margin="0,5,0,0"/></StackPanel><StackPanel x:Name="RepeatFieldsPanel" Grid.Column="2"><TextBlock Text="重复间隔" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding RepeatIntervals, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding RepeatInterval}" Margin="0,5,0,0"/></StackPanel></Grid>
                <StackPanel x:Name="RepeatEndPanel" Margin="0,10,0,0"><TextBlock Text="重复结束日期（可不填）" Foreground="{StaticResource MutedBrush}"/><DatePicker SelectedDate="{Binding RepeatEndDate}" Margin="0,5,0,0"/></StackPanel>
            </StackPanel></Border>
            <Border Background="#F5F7FA" CornerRadius="9" Padding="14" Margin="0,0,0,13"><StackPanel>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="子任务" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋ 添加子任务" Click="AddSubTask_Click" Padding="9,5"/></Grid>
                <ItemsControl ItemsSource="{Binding SubTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Top" Margin="0,7,8,0" ToolTip="标记子任务完成"/><StackPanel Grid.Column="1"><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="子任务标题"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ToolTip="子任务备注（可选）" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="3" Content="删除" Tag="{Binding}" Click="DeleteSubTask_Click" Padding="8,5" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="可为每个子任务单独勾选完成并填写备注。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="任务注释 / 处理说明" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding CompletionNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" VerticalContentAlignment="Top" Margin="0,5,0,0"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,9,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
